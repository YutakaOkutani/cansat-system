# Copy this file to mission.toml on each Raspberry Pi and edit it there.
# mission.toml is intentionally ignored by Git.
# Competition/run labels belong in run-context.toml, not in this control file.

[target]
# Deliberately invalid placeholders: mission startup fails until both are edited.
latitude = 999.0
longitude = 999.0

[radio]
# "mission" disables Wi-Fi during Phase0; "off" leaves Wi-Fi enabled.
control = "off"
pre_off_delay_sec = 3
restore_timeout_sec = 180
use_sudo = true
dry_run = false

# Optional P6 tuning. Omitted keys use these field-test defaults.
# Total mission limit: 20 min; P4: 120/180 s; P5: 180/240 s; P6: 180 s.
[approach]
far_forward_sec = 0.4
far_forward_boost_sec = 0.6
far_forward_pwm = 70
far_forward_boost_pwm = 75
far_align_sec = 0.15
far_align_boost_sec = 0.30
far_align_pwm = 65
far_align_boost_pwm = 75
forward_output_limit_sec = 60
align_output_limit_sec = 20
